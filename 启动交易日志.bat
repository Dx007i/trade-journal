@echo off
title 交易日志系统

set PORT=8897
set "SCRIPT_DIR=%~dp0"
set "EXE_PATH=%SCRIPT_DIR%交易日志系统.exe"

REM ============================================================
REM 1. 检查 exe 是否存在
REM ============================================================
if not exist "%EXE_PATH%" (
    echo ========================================
    echo   [错误] 找不到 交易日志系统.exe
    echo   请确认本脚本和 交易日志系统.exe 在同一文件夹
    echo ========================================
    pause
    exit /b 1
)

REM ============================================================
REM 2. 检测端口是否已被占用（服务已在运行）
REM ============================================================
netstat -ano | findstr :%PORT% | findstr LISTENING >nul 2>&1
if %errorlevel%==0 (
    echo 服务已在运行，直接打开浏览器...
    start "" http://127.0.0.1:%PORT%
    ping 127.0.0.1 -n 3 >nul
    exit /b 0
)

REM ============================================================
REM 3. 启动 exe（后台静默运行，无窗口）
REM ============================================================
echo 正在启动交易日志系统...
start "" "%EXE_PATH%"

REM ============================================================
REM 4. 等待服务就绪（最多等 15 秒）
REM    检测到端口就绪立即开浏览器并退出，不依赖延迟变量
REM ============================================================
for /l %%i in (1,1,15) do (
    ping 127.0.0.1 -n 2 >nul
    netstat -ano | findstr :%PORT% | findstr LISTENING >nul 2>&1
    if not errorlevel 1 goto :ready
)

REM 走到这里说明 15 秒还没就绪
echo.
echo ========================================
echo   [警告] 服务可能未成功启动
echo   请尝试：
echo   1. 检查 %PORT% 端口是否被其他程序占用
echo   2. 直接双击 交易日志系统.exe 启动
echo ========================================
pause
exit /b 1

:ready
echo.
echo ========================================
echo   启动成功！
echo   访问地址: http://127.0.0.1:%PORT%
echo ========================================
start "" http://127.0.0.1:%PORT%
echo 浏览器已自动打开，本窗口 3 秒后自动关闭。
ping 127.0.0.1 -n 4 >nul
exit /b 0
